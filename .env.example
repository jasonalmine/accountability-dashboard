# --- GoHighLevel: the store ---
# A LOCATION Private Integration Token (not agency) with contacts read/write,
# custom fields, and notes. Provision the custom fields on the location first,
# or writes return 200 and persist nothing.
GHL_PIT=
GHL_LOCATION_ID=

# Shared password for the facilitator dashboard at /dashboard.
# The member pages (/ and /checkin/<token>) are deliberately NOT behind this.
DASHBOARD_PASSWORD=

# --- branding: all optional, all have sensible defaults ---
GROUP_NAME="Tuesday Builders"
COURSE_NAME="Intro to Web Development"
SESSION_SCHEDULE="Tuesdays 7pm with Ana, Thursdays 2pm with Ben"
# Tell members exactly where to find their own number.
PROGRESS_HINT="Open your course page and read the line at the bottom: \"X of 100 lessons completed\"."
# Cohort options offered at sign-up.
BATCHES="Batch 1,Batch 2,Batch 3"

# Who may register. Comma- or newline-separated. This is an allowlist: the CRM
# cannot hold a contact without an email, and members have none until sign-up,
# so the roster lives here and a contact is created at registration.
ROSTER="Ana Beatriz Silva,Ben Halloran,Chen Wei"
# Optional: members whose attendance is required.
PRIORITY_MEMBERS=

# --- optional: hand off each intake and check-in to an automation platform ---
# Unset means the handoff is skipped and the check-in still persists.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
