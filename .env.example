# --- GoHighLevel: the store ---
# A LOCATION Private Integration Token (not agency) with contacts read/write,
# custom fields, and notes. Provision the custom fields on the location first,
# or writes return 200 and persist nothing.
GHL_PIT=
GHL_LOCATION_ID=

# Shared password for the facilitator dashboard at /dashboard.
# The member pages (/ and /checkin/<token>) are deliberately NOT behind this.
DASHBOARD_PASSWORD=

# Signs check-in links. Any long random string; changing it invalidates every
# issued link. At least 16 characters.
TOKEN_SECRET=

# --- branding: all optional, all have sensible defaults ---
GROUP_NAME="Tuesday Builders"
COURSE_NAME="Intro to Web Development"
SESSION_SCHEDULE="Tuesdays 7pm with Ana, Thursdays 2pm with Ben"
# Tell members exactly where to find their own number.
PROGRESS_HINT="Open your course page and read the line at the bottom: \"X of 100 lessons completed\"."
# Cohort options offered at sign-up.
BATCHES="Batch 7,Batch 8,Batch 9,Batch 10"

# Optional. Names you EXPECT to register, comma- or newline-separated. This is
# not a gate: anyone with the link can register. It exists so the dashboard can
# show who has not signed up yet. Leave empty to show only registered members.
ROSTER=
# Optional: members whose attendance is required.
PRIORITY_MEMBERS=

# Override the built-in example curriculum without forking. JSON arrays.
# COURSE_MODULES='[{"key":"MODULE 1","label":"Module 1: Foundations","lessons":8,"visible":true}]'
# COURSE_STAGES='[{"name":"In Progress","denominator":100}]'
COURSE_MODULES=
COURSE_STAGES=

# --- optional: mirror progress into a CRM pipeline stage ---
# A stage change is a workflow trigger, so "entered Certification Ready" can
# start a sequence. Leave unset to skip mirroring entirely.
PIPELINE_ID=
# stage name -> stage id
PIPELINE_STAGES=
# cumulative lesson bands, in order; last one uses "upTo": null
# [{"name":"Registered","upTo":0},{"name":"Foundations","upTo":39},...]
PIPELINE_BANDS=

# --- optional: hand off each intake and check-in to an automation platform ---
# Unset means the handoff is skipped and the check-in still persists.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
